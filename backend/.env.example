# CODE3D-AI Spring Boot Backend Environment Variables
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database
DB_URL=jdbc:postgresql://<neon-subdomain>.neon.tech/neondb?sslmode=require&connectTimeout=30&socketTimeout=30
DB_USERNAME=neondb_owner
DB_PASSWORD=<neon-database-password>

# AI API Key (Optional)
AI_API_KEY=
JWT_SECRET=your-random-256-bit-secret-key-at-least-32-chars
