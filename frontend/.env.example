# CODE3D-AI Frontend Environment Variables
#
# Public Endpoint Configuration:
# Note: Any API URL bundled into client-side code is visible in network requests and JavaScript bundles.
# Never place secret API keys (e.g. GROQ_API_KEY) or database credentials in frontend variables.
#
# Option 1 (Standard Vite Public Variable):
# In Vercel Project Settings -> Environment Variables:
# VITE_BACKEND_URL=https://code3d-ai.onrender.com/api
#
# Option 2 (Clean Vercel without VITE_ public-prefix warning):
# In Vercel Project Settings -> Environment Variables:
# BACKEND_URL=https://code3d-ai.onrender.com/api
# (vite.config.js reads BACKEND_URL during build and exposes it safely)
#
# Option 3 (Zero Environment Variables on Vercel):
# Leave unset. vercel.json automatically proxies /api/:path* to the Render backend,
# and frontend/src/services/api.js defaults to https://code3d-ai.onrender.com/api.
VITE_BACKEND_URL=https://code3d-ai.onrender.com/api


