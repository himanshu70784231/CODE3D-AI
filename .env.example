# ====================================================================
# CODE3D-AI Environment Configuration Example
# Copy to .env or configure in your deployment platform (Neon, Render, Vercel)
# ====================================================================

# Frontend Environment Variables (Vite)
# Point to your deployed Spring Boot backend URL in production
VITE_API_BASE_URL=http://localhost:8080/api

# Backend Environment Variables (Spring Boot)
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database Credentials
DB_URL=jdbc:postgresql://<neon-host-pooler>.neon.tech/neondb?sslmode=require&connectTimeout=30&socketTimeout=30
DB_USERNAME=neondb_owner
DB_PASSWORD=<neon-password>

# AI Explanation & Tutor API Key (Optional Gemini / OpenAI key)
AI_API_KEY=
JWT_SECRET=your-secure-256-bit-secret-key-here
